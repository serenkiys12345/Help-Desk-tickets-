# --------------------------- Вспомогательные функции ---------------------------
def clean_text(text: str) -> str:
    """Убираем лишние пробелы и переводы строк."""
    return re.sub(r'\s+', ' ', text).strip()

def remove_names(text: str) -> str:
    """Удаляем заданные имена из текста (заменяем на пробел)."""
    pattern = r'\b(' + '|'.join(re.escape(name) for name in NAMES_TO_REMOVE) + r')\b'
    return re.sub(pattern, ' ', text, flags=re.IGNORECASE)

def get_email_body(msg: email.message.Message) -> str:
    """Извлекаем тело письма (предпочитаем plain text)."""
    if msg.is_multipart():
        for part in msg.walk():
            content_type = part.get_content_type()
            content_disposition = str(part.get("Content-Disposition"))
            if content_type == "text/plain" and "attachment" not in content_disposition:
                payload = part.get_payload(decode=True)
                if payload:
                    charset = part.get_content_charset() or 'utf-8'
                    return payload.decode(charset, errors='replace')
        for part in msg.walk():
            if part.get_content_type() == "text/html":
                payload = part.get_payload(decode=True)
                if payload:
                    charset = part.get_content_charset() or 'utf-8'
                    text = re.sub(r'<[^>]+>', '', payload.decode(charset, errors='replace'))
                    return clean_text(text)
    else:
        payload = msg.get_payload(decode=True)
        if payload:
            charset = msg.get_content_charset() or 'utf-8'
            return payload.decode(charset, errors='replace')
    return ""

def extract_relevant_text(body: str) -> str:
    """Извлекаем текст между стартовой фразой (первая непустая) и стоп-фразой."""
    text = None
    for phrase in START_PHRASES:
        idx = body.find(phrase)
        if idx != -1:
            after = body[idx + len(phrase):].strip()
            if after:
                text = after
                break
    if text is None:
        return ""
    stop_idx = text.find(STOP_PHRASE)
    if stop_idx != -1:
        text = text[:stop_idx].strip()
    return clean_text(text)

def fetch_emails():
    """Загружаем письма за период от заданного отправителя."""
    mail = imaplib.IMAP4_SSL(IMAP_SERVER, IMAP_PORT)
    mail._encoding = 'utf-8'
    mail.login(USERNAME, PASSWORD)
    mail.select("INBOX")

    since = DATE_START.strftime("%d-%b-%Y")
    before = (DATE_END + timedelta(days=1)).strftime("%d-%b-%Y")
    search_criteria = f'(SINCE {since} BEFORE {before})'

    status, message_ids = mail.search(None, search_criteria)
    if status != 'OK':
        raise RuntimeError(f"Ошибка поиска писем: {status}")

    ids = message_ids[0].split()
    emails_data = []
    for num in ids:
        status, msg_data = mail.fetch(num, '(RFC822)')
        if status != 'OK':
            continue
        raw_email = msg_data[0][1]
        msg = email.message_from_bytes(raw_email)

        # Проверка отправителя
        from_field = msg.get('From', '')
        real_name, from_addr = parseaddr(from_field)
        if from_addr.lower() != ALLOWED_SENDER.lower():
            continue

        # Проверка даты
        date_str = msg.get('Date')
        if date_str:
            try:
                email_date = parsedate_to_datetime(date_str)
                email_date = email_date.replace(tzinfo=None)
                if email_date < DATE_START or email_date > DATE_END + timedelta(days=1):
                    continue
            except Exception:
                pass

        body = get_email_body(msg)
        if not body:
            continue
        # Удаляем имена перед извлечением текста
        body_clean = remove_names(body)
        relevant = extract_relevant_text(body_clean)
        if relevant and len(relevant) >= 3:
            emails_data.append(relevant)
    mail.logout()
    return emails_data

# --------------------------- Классификация ---------------------------
def classify_text(text: str) -> str:
    """Возвращает название группы на основе ключевых слов."""
    lower = text.lower()
    tokens = re.findall(r'[а-яёa-z]+', lower)

    # 1. Проверяем РМИС (точные совпадения аббревиатур) – в первую очередь
    for token in tokens:
        if token in RMIS_WORDS:
            return "РМИС"

    # Стеммируем все токены
    stems = {stem(t) for t in tokens}

    # 2. Оргтехника
    if stems & OFFICE_EQUIPMENT:
        return "Оргтехника"

    # 3. Электронная подпись
    if stems & EDS_KEYWORDS:
        return "Электронная подпись"

    # 4. Компьютеры
    if stems & COMPUTER_KEYWORDS:
        return "Компьютеры"

    # 5. Программы
    if stems & SOFTWARE_KEYWORDS:
        return "Программы"

    return "Прочее"

